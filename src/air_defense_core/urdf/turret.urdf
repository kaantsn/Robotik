<?xml version="1.0"?>
<robot name="ciws_turret">
  <link name="world"/>
  <joint name="world_to_base" type="fixed"><parent link="world"/><child link="base_link"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>

  <link name="base_link">
    <visual><geometry><cylinder length="0.2" radius="1.2"/></geometry><origin xyz="0 0 0.1"/><material name="dark"><color rgba="0.2 0.2 0.2 1.0"/></material></visual>
    <collision><geometry><cylinder length="0.2" radius="1.2"/></geometry><origin xyz="0 0 0.1"/></collision>
    <inertial><mass value="1000.0"/><inertia ixx="100.0" ixy="0" ixz="0" iyy="100.0" iyz="0" izz="200.0"/></inertial>
  </link>

  <link name="yaw_link">
    <visual><geometry><box size="1.2 1.2 1.5"/></geometry><origin xyz="0 0 0.95"/><material name="white"><color rgba="0.85 0.85 0.9 1.0"/></material></visual>
    <collision><geometry><box size="1.2 1.2 1.5"/></geometry><origin xyz="0 0 0.95"/></collision>
    <inertial><mass value="300.0"/><origin xyz="0 0 0.95"/><inertia ixx="40.0" ixy="0" ixz="0" iyy="40.0" iyz="0" izz="40.0"/></inertial>
  </link>
  <joint name="base_to_yaw" type="continuous"><parent link="base_link"/><child link="yaw_link"/><origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 0 1"/></joint>

  <link name="pitch_link">
    <visual><geometry><box size="1.0 1.0 0.8"/></geometry><origin xyz="0.2 0 0"/><material name="grey"><color rgba="0.5 0.5 0.5 1.0"/></material></visual>
    <visual><geometry><cylinder length="2.5" radius="0.12"/></geometry><origin xyz="1.5 0 0" rpy="0 1.5708 0"/><material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material></visual>
    <visual><geometry><box size="1.5 0.4 0.5"/></geometry><origin xyz="0.5 0.7 0"/><material name="dark_grey"><color rgba="0.3 0.3 0.3 1.0"/></material></visual>
    <visual><geometry><box size="1.5 0.4 0.5"/></geometry><origin xyz="0.5 -0.7 0"/><material name="dark_grey"><color rgba="0.3 0.3 0.3 1.0"/></material></visual>
    <visual><geometry><cylinder length="0.1" radius="0.4"/></geometry><origin xyz="0.2 0 0.5" rpy="0 0.5 0"/><material name="gold"><color rgba="0.8 0.6 0.1 1.0"/></material></visual>

    <collision><geometry><box size="1.5 1.8 1.2"/></geometry><origin xyz="0.2 0 0"/></collision>
    <inertial><mass value="100.0"/><origin xyz="0 0 0"/><inertia ixx="10.0" ixy="0" ixz="0" iyy="10.0" iyz="0" izz="10.0"/></inertial>
  </link>
  <joint name="yaw_to_pitch" type="continuous"><parent link="yaw_link"/><child link="pitch_link"/><origin xyz="0 0 2.0" rpy="0 0 0"/><axis xyz="0 -1 0"/></joint>

  <gazebo reference="base_link"><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></gazebo>
  <gazebo reference="yaw_link"><material><ambient>0.85 0.85 0.9 1</ambient><diffuse>0.85 0.85 0.9 1</diffuse></material></gazebo>
  <gazebo reference="pitch_link"><material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material></gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>base_to_yaw</joint_name><topic>/cmd_yaw</topic><p_gain>8000</p_gain><i_gain>50</i_gain><d_gain>800</d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>yaw_to_pitch</joint_name><topic>/cmd_pitch</topic><p_gain>8000</p_gain><i_gain>50</i_gain><d_gain>800</d_gain>
    </plugin>
  </gazebo>
</robot>
