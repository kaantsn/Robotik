<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="enemy_missile">
    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"/>
    <link name="base_link">
      <gravity>false</gravity>
      <visual name="body"><geometry><cylinder radius="0.15" length="1.5"/></geometry><pose>0 0 0 0 1.5708 0</pose><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
      <visual name="nose"><geometry><cone><radius>0.15</radius><length>0.5</length></cone></geometry><pose>1.0 0 0 0 1.5708 0</pose><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
      <visual name="wings"><geometry><box><size>0.4 1.5 0.05</size></box></geometry><pose>-0.2 0 0 0 0 0</pose><material><ambient>0.8 0 0 1</ambient><diffuse>0.8 0 0 1</diffuse></material></visual>
    </link>
  </model>
</sdf>
