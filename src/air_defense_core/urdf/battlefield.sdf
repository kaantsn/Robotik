<?xml version="1.0" ?><sdf version="1.8"><world name="battlefield">
  <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
  <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
  <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
  <scene><ambient>0.8 0.8 0.8 1</ambient><shadows>false</shadows></scene>
  <light type="directional" name="sun"><pose>0 0 10 0 0 0</pose><diffuse>1 1 1 1</diffuse><cast_shadows>false</cast_shadows></light>
  <model name="ground"><static>true</static><link name="link"><visual name="vis"><geometry><plane><normal>0 0 1</normal><size>1000 1000</size></plane></geometry><material><ambient>0.2 0.5 0.2 1</ambient></material></visual></link></model>
</world></sdf>
